# App (optional)
# APP_BASE_PATH=
# APP_ENV=production

# Database — use MySQL on Render (external or Render MySQL); SQLite only for local
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Uploads (optional; defaults: storage/uploads/donations, storage/uploads/registrations, 5MB)
# UPLOAD_DONATIONS_DIR=
# UPLOAD_REGISTRATIONS_DIR=
# UPLOAD_MAX_BYTES=5242880
# Railway persistent volume example:
# UPLOAD_DONATIONS_DIR=/data/uploads/donations
# UPLOAD_REGISTRATIONS_DIR=/data/uploads/registrations

# Render sets PORT automatically; for local Docker use 8080
